// Schema Prisma — Núcleo (Etapa 1 / Base-Core)
//
// Implementa únicamente las entidades estructurales definidas en
// docs/ETAPA-0-ANALISIS-ARQUITECTURA.md (sección 10.1, "Núcleo organizacional") y
// sección 10.9 ("Auditoría"). NO incluye ninguna tabla funcional de etapas
// posteriores (stock, ventas, mermas, BOM, cierres, caja, etc.) — ver
// docs/ETAPA-1-BASE-CORE.md, sección "Qué NO se implementó (a propósito)".
//
// Convenciones (idénticas a las de Etapa 0, sección 10):
//   - PK uuid con default aleatorio.
//   - organization_id NOT NULL en toda entidad operativa (RNF-011).
//   - created_at en toda tabla; updated_at sólo en catálogos editables in-place.
//   - Nunca DELETE físico de historial: audit_log es append-only (sin updated_at).
//   - Nombres de tabla/columna en snake_case en Postgres (vía @map/@@map);
//     camelCase del lado de Prisma/TypeScript, que es la convención idiomática
//     del ecosistema y no cambia el DDL real que Etapa 0 especificó.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Roles operativos confirmados por el relevamiento (Etapa 0, sección 7).
/// SUPER_ADMIN (Hito 2, multi-organización) no se agrega todavía: no está
/// respaldado como necesidad de Hito 1 y este informe no adelanta etapas futuras.
enum RoleCode {
  ADMIN
  DEPOSIT_MANAGER
  SHOP_EMPLOYEE

  @@map("role_code")
}

/// Tipos de ubicación (Etapa 0, sección 5): entidad genérica, no hardcodeada
/// como "depósito"/"heladería", tal como exige el documento de requisitos del cliente.
enum LocationType {
  DEPOT
  ICE_CREAM_SHOP
  STORE
  OTHER

  @@map("location_type")
}

enum AuditResult {
  OK
  ERROR
  REJECTED

  @@map("audit_result")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  timezone  String   @default("America/Argentina/Cordoba")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  locations          Location[]
  users              AppUser[]
  auditLogs          AuditLog[]
  categories         Category[]
  productTypes       ProductType[]
  unitsOfMeasure     UnitOfMeasure[]
  flavors            Flavor[]
  products           Product[]
  inventoryMovements InventoryMovement[]

  @@map("organization")
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  type           LocationType
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users              AppUser[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, name])
  /// Habilita FKs compuestas (organizationId, locationId) desde AppUser,
  /// AuditLog e InventoryMovement — Etapa 3 (ver
  /// docs/ETAPA-3-MOTOR-INVENTARIO.md, sección "Multi-organización").
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("location")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  code RoleCode @unique
  name String

  users AppUser[]

  @@map("role")
}

/// Identidad individual (P-001 RESUELTA — ver docs/ETAPA-0-ANALISIS-ARQUITECTURA.md v1.2,
/// sección 18.2, Opción A). Una fila = una persona física con cuenta propia en
/// Supabase Auth. Nunca una cuenta compartida por rol/ubicación como identidad principal.
model AppUser {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  roleId            String    @map("role_id") @db.Uuid
  /// Ubicación asignada. NULL para ADMIN (acceso a toda la organización) — ver
  /// docs/ETAPA-0-ANALISIS-ARQUITECTURA.md sección 7 (actores y permisos).
  defaultLocationId String?   @map("default_location_id") @db.Uuid
  displayName       String    @map("display_name")
  /// Email de contacto/invitación. Campo agregado en Etapa 1 (no estaba en el
  /// sketch de Etapa 0): es una necesidad técnica del flujo de alta de usuarios
  /// vía Supabase Auth (invitación por email), no un requisito de negocio nuevo.
  /// Ver docs/ETAPA-1-BASE-CORE.md, sección "Desviaciones respecto de Etapa 0".
  email             String    @unique
  /// id del usuario en Supabase Auth (auth.users.id). Es lo que llega en el JWT
  /// verificado por el backend en cada request.
  authSubject       String    @unique @map("auth_subject")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// FK compuesta (organizationId, defaultLocationId) -> Location(organizationId, id):
  /// pendiente detectado en Etapa 2.1 (docs/ETAPA-2.1-INTEGRIDAD-MULTIORGANIZACION.md,
  /// sección 14), corregido acá porque Etapa 3 ya necesita tocar AppUser/Location
  /// para el ledger y es seguro hacerlo sin ampliar alcance funcional. Nullable
  /// (NULL para ADMIN): Postgres no exige la FK cuando lo es. `onDelete: Restrict`
  /// (antes `SetNull` en la FK simple de Etapa 1): con FK compuesta, `SetNull`
  /// intentaría poner en NULL también `organizationId`, que es NOT NULL --
  /// Prisma lo señala como advertencia de esquema inválido. `Restrict` es
  /// coherente con el resto del esquema y con que `Location` nunca se borra
  /// físicamente (baja lógica vía `active`, Etapa 2).
  defaultLocation    Location?           @relation(fields: [organizationId, defaultLocationId], references: [organizationId, id], onDelete: Restrict)
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]

  @@index([organizationId])
  @@index([roleId])
  /// Habilita FKs compuestas (organizationId, userId) desde AuditLog e
  /// InventoryMovement (createdBy) — Etapa 3.
  @@unique([organizationId, id])
  @@map("app_user")
}

/// Infraestructura de auditoría base (Etapa 1). `action`, `module`, `entityType` son
/// texto libre a propósito: los módulos funcionales futuros (stock, ventas, mermas,
/// caja, cierres) agregarán sus propias acciones sin requerir una migración de esquema
/// ni tocar esta tabla — ver docs/ETAPA-0-ANALISIS-ARQUITECTURA.md, sección 10.9 y 15.
/// Append-only: nunca se actualiza ni se borra un registro ya escrito (RN-009/RN-061).
model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  correlationId  String?     @map("correlation_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  roleCode       RoleCode?   @map("role_code")
  locationId     String?     @map("location_id") @db.Uuid
  action         String
  module         String
  entityType     String?     @map("entity_type")
  entityId       String?     @map("entity_id") @db.Uuid
  beforeValue    Json?       @map("before_value")
  afterValue     Json?       @map("after_value")
  reason         String?
  result         AuditResult @default(OK)
  errorDetail    String?     @map("error_detail")
  ipAddress      String?     @map("ip_address")
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FKs compuestas (organizationId, userId) y (organizationId, locationId):
  /// mismo pendiente de Etapa 2.1, corregido junto con AppUser.defaultLocationId
  /// en Etapa 3 (ver docs/ETAPA-3-MOTOR-INVENTARIO.md). Ambas nullable: Postgres
  /// no exige la FK cuando lo son (evento de sistema sin actor/ubicación).
  /// `onDelete: Restrict` por el mismo motivo que en AppUser.defaultLocation
  /// (SetNull es inválido en una FK compuesta con organizationId NOT NULL).
  user     AppUser?  @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  location Location? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, occurredAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Catálogo y maestros (Etapa 2) — ver docs/ETAPA-2-CATALOGO-MAESTROS.md.
//
// Sólo estructura de datos maestros (RF-001 a RF-007 de Etapa 0, CONFIRMADOS).
// Ninguna tabla de esta sección es un movimiento ni afecta stock: eso es el
// motor de inventario de una etapa posterior (ledger, conteos, BOM funcional,
// mermas, etc. — explícitamente fuera de Etapa 2).
//
// Baja lógica en las 5 entidades (nunca DELETE físico vía API): un maestro
// puede estar referenciado por historial futuro (productos, movimientos), así
// que todas usan `active`, igual que Location/AppUser en Etapa 1.

/// Categoría/grupo de producto (RF-002/RN-002, CONFIRMADO). Auto-referencial
/// para representar el "grupo" (parentCategoryId = null) y el "subgrupo"
/// opcional (RN-002: "un producto pertenece a un grupo y opcionalmente a un
/// subgrupo") con una única tabla, en vez de dos tablas separadas: ambos
/// niveles comparten exactamente los mismos atributos (nombre, organización,
/// estado), y el material real (hoja PRODUCTOS de Habash) sólo usa un nivel
/// plano de 35 categorías variables — no hay evidencia de una tabla de
/// subgrupos distinta, así que se prepara el nivel opcional sin inventar una
/// segunda entidad. Datos persistidos, nunca hardcodeados en frontend (Etapa 2 §5).
model Category {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  name             String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FK compuesta (organizationId, parentCategoryId) -> Category(organizationId, id):
  /// garantiza en PostgreSQL que una subcategoría no pueda apuntar a un grupo
  /// padre de otra organización (Etapa 2.1 — ver
  /// docs/ETAPA-2.1-INTEGRIDAD-MULTIORGANIZACION.md). Al ser parentCategoryId
  /// nullable, Postgres no exige la FK cuando es NULL (categoría raíz), que es
  /// el comportamiento deseado.
  parentCategory Category?    @relation("CategoryToSubcategory", fields: [organizationId, parentCategoryId], references: [organizationId, id], onDelete: Restrict)
  subcategories  Category[]   @relation("CategoryToSubcategory")
  products       Product[]

  @@unique([organizationId, parentCategoryId, name])
  /// Habilita que otras tablas (Product, la propia Category) referencien esta
  /// fila con una FK compuesta (organizationId, id) — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([parentCategoryId])
  @@map("category")
}

/// Tipo/línea de producto (RF-002, CONFIRMADO como campo; valores RESPALDADOS
/// por evidencia real: columna "PALLET" de la hoja PRODUCTOS de Habash sólo
/// contiene HELADO/INSUMO en las 214 filas reales -- ver
/// docs/ETAPA-2-CATALOGO-MAESTROS.md, matriz de decisiones). Tabla persistida
/// en vez de enum Prisma, igual criterio que Category (Etapa 2 §5: evitar
/// rigidez si no hay confirmación textual del cliente de que sea una lista
/// cerrada para siempre). Sin API de alta en esta etapa -- ver sección
/// "Permisos" del documento de Etapa 2: catálogo técnico sembrado, sólo lectura.
model ProductType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, code])
  /// Habilita la FK compuesta (organizationId, productTypeId) en Product — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("product_type")
}

/// Unidad de manejo (Etapa 2 §7: "unidad; lata; caja"). Tabla persistida, no
/// hardcodeada en frontend. Igual que ProductType: catálogo técnico sembrado
/// (evidencia real: columna UNIDAD de la hoja PRODUCTOS sólo usa
/// CAJA/LATA/UNIDAD), sin API de alta en esta etapa.
model UnitOfMeasure {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products           Product[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, code])
  /// Habilita la FK compuesta (organizationId, unitOfMeasureId) en Product — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("unit_of_measure")
}

/// Sabor de helado (RF-003/RN-003, CONFIRMADO: "los sabores de helado a granel
/// siempre se registran, cuentan y analizan individualmente"). Entidad propia,
/// separada de Product, para que el análisis/consumo futuro por sabor no
/// dependa de una presentación/envase puntual -- aunque hoy, en el material
/// real, cada sabor corresponde 1:1 a un producto (lata), la relación
/// Product.flavorId permite que eso deje de ser así sin migrar el esquema.
model Flavor {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, name])
  /// Habilita la FK compuesta (organizationId, flavorId) en Product — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("flavor")
}

/// Catálogo único de productos (RF-001, CONFIRMADO: "UUID propio, nunca el
/// nombre como clave"). Entidad central de Etapa 2 -- ver
/// docs/ETAPA-2-CATALOGO-MAESTROS.md, sección "Modelo implementado", para la
/// justificación completa de cada campo contra el material real y contra
/// RF-001..RF-007 de Etapa 0.
///
/// NO incluye: costo (RN-002/RN-003 lo ubican a nivel de Category, pero su
/// implementación real -- costo vigente, historial -- es RF-039, P3, fuera del
/// Hito 1; no se adelanta), código externo/SAP ni alias (RF-004 es CONFIRMADO
/// pero su único consumo es matching de importación de ventas/facturas,
/// explícitamente fuera de Etapa 2), BOM (RF-007, fuera de Etapa 2), stock
/// mínimo/ideal (pertenece al motor de inventario, fuera de Etapa 2).
model Product {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  /// Código de negocio legible, opcional (RF-001: la clave real es el `id`
  /// UUID; este campo es sólo una referencia humana, como la que ya usa el
  /// sistema actual -- p. ej. "P001"). Único por organización cuando se define;
  /// Postgres permite múltiples NULL en una constraint UNIQUE, así que un
  /// producto sin código no colisiona con otro.
  code            String?
  name            String
  categoryId      String   @map("category_id") @db.Uuid
  productTypeId   String   @map("product_type_id") @db.Uuid
  unitOfMeasureId String   @map("unit_of_measure_id") @db.Uuid
  /// Equivalencia/factor de conversión del producto (RF-002 "unidades por
  /// presentación"; RN-006 "factor de conversión del producto", singular):
  /// cuántas unidades sueltas contiene la unidad de manejo de este producto.
  /// 1 cuando la unidad de manejo ya es la unidad mínima (ej. LATA, UNIDAD).
  unitsPerHandlingUnit Int  @default(1) @map("units_per_handling_unit")
  /// Sabor asociado, sólo para productos que lo tienen (RF-003). NULL para
  /// insumos, packaging, etc.
  flavorId        String?  @map("flavor_id") @db.Uuid
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FKs compuestas (organizationId, xId) -> Master(organizationId, id) en las
  /// cuatro relaciones de abajo: garantizan en PostgreSQL que un producto no
  /// pueda referenciar una categoría/tipo/unidad/sabor de otra organización,
  /// además de la validación ya existente en el backend (Etapa 2.1 — ver
  /// docs/ETAPA-2.1-INTEGRIDAD-MULTIORGANIZACION.md). flavorId es nullable:
  /// Postgres no exige la FK cuando es NULL (producto sin sabor).
  category      Category      @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  productType   ProductType   @relation(fields: [organizationId, productTypeId], references: [organizationId, id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure @relation(fields: [organizationId, unitOfMeasureId], references: [organizationId, id], onDelete: Restrict)
  flavor        Flavor?       @relation(fields: [organizationId, flavorId], references: [organizationId, id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, code])
  /// Habilita la FK compuesta (organizationId, productId) desde InventoryMovement — Etapa 3.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([categoryId])
  @@index([flavorId])
  @@map("product")
}

// ---------------------------------------------------------------------------
// Motor de inventario / ledger (Etapa 3) — ver docs/ETAPA-3-MOTOR-INVENTARIO.md
// y docs/INVARIANTES-INVENTARIO.md.
//
// Principio (CONFIRMADO, Doc §3.2/§10, RN-007): el stock es siempre una
// CONSECUENCIA de los movimientos del ledger, nunca un número editable. No
// existe ninguna columna "stock_actual": todo cálculo de stock teórico se
// hace agregando InventoryMovement en el momento de la consulta (sección
// "Cálculo de stock teórico" del documento de Etapa 3).
//
// Append-only (RN-008/RN-009): un InventoryMovement nunca se edita ni se
// borra una vez creado. Una corrección genera un movimiento de reversión
// nuevo (`reversesMovementId`) que referencia al original, que a su vez pasa
// a `status = REVERSED` — nunca se muta `quantity` de un movimiento existente.

/// Tipos de movimiento (RF-010, CONFIRMADO — lista textual del cliente, Doc
/// §10). El enum completo se declara ahora porque forma parte del dominio ya
/// confirmado y así ninguna etapa futura necesita una migración sólo para
/// agregar un valor a este enum (evitando un ALTER TYPE sobre una tabla que
/// crecerá continuamente) — pero sólo un subconjunto tiene, en esta etapa,
/// un servicio/endpoint que efectivamente lo genere (ver docs/ETAPA-3-MOTOR-INVENTARIO.md,
/// sección "Tipos de movimiento", que distingue IMPLEMENTADO de RESERVADO).
///
/// IMPLEMENTADO en Etapa 3: INITIAL_STOCK, ADJUSTMENT (y la reversión
/// genérica, que reutiliza el tipo del movimiento original).
/// RESERVADO/PREPARADO (el valor existe para integridad referencial futura,
/// ningún endpoint de Etapa 3 lo genera todavía): PURCHASE_RECEIPT,
/// TRANSFER_OUT, TRANSFER_IN, SALE, BOM_CONSUMPTION, WASTE,
/// ICE_CREAM_CONTAINER_CLOSE, EXTERNAL_OUT, COUNT_CORRECTION.
enum MovementType {
  INITIAL_STOCK
  PURCHASE_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  BOM_CONSUMPTION
  WASTE
  ICE_CREAM_CONTAINER_CLOSE
  ADJUSTMENT
  EXTERNAL_OUT
  COUNT_CORRECTION

  @@map("movement_type")
}

/// Estado del movimiento (arquitectura Etapa 0, sección 10.3/11.4). NO es un
/// filtro del cálculo de stock teórico -- el saldo siempre suma TODOS los
/// movimientos (activos y revertidos), porque la reversión ya aporta su
/// propia cantidad de signo opuesto (ver apps/api/src/services/inventory-ledger.ts,
/// `getStockBalances`); excluir los REVERSED del SUM restaría el original
/// sin sumar de vuelta su efecto y dejaría el saldo mal calculado. `status`
/// sirve sólo para trazabilidad (marcar qué movimiento fue corregido) y como
/// guarda contra una doble reversión del mismo movimiento (sólo se puede
/// revertir un movimiento con status = ACTIVE).
enum MovementStatus {
  ACTIVE
  REVERSED

  @@map("movement_status")
}

/// Ledger central de movimientos de inventario (RF-009, RN-007..RN-010,
/// CONFIRMADO). Única puerta de escritura de stock del sistema — ver
/// apps/api/src/services/inventory-ledger.ts.
model InventoryMovement {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  locationId     String         @map("location_id") @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  movementType   MovementType   @map("movement_type")

  /// Cantidad normalizada a la unidad canónica del producto ("unidades
  /// sueltas", el mismo concepto que `Product.unitsPerHandlingUnit` ya usa
  /// desde Etapa 2 — RESPALDADO, no una entidad nueva). Con signo: entradas
  /// positivas, salidas negativas (RN-010, arquitectura Etapa 0 §10.3). Es
  /// la que se usa para calcular el stock teórico (SUM). NUMERIC en vez de
  /// float de JS/Postgres double precision, para no perder precisión al
  /// sumar miles de movimientos -- ver docs/ETAPA-3-MOTOR-INVENTARIO.md,
  /// sección "Cantidades y precisión", sobre la escala elegida.
  quantity Decimal @db.Decimal(14, 3)

  /// Cantidad tal como la tipeó el usuario, en `entryUnitOfMeasureId` (RN-006:
  /// "el usuario nunca calcula la conversión a mano"). Mismo signo que
  /// `quantity`. Se conserva junto al factor usado para que la pantalla
  /// pueda mostrar "2 cajas" además del canónico, sin recalcular.
  enteredQuantity Decimal @map("entered_quantity") @db.Decimal(14, 3)

  /// Unidad en la que se cargó el movimiento (p. ej. la unidad de manejo del
  /// producto). FK compuesta multi-organización -- sección "Multi-organización".
  entryUnitOfMeasureId String @map("entry_unit_of_measure_id") @db.Uuid

  /// Factor de conversión (equivalente a `Product.unitsPerHandlingUnit`)
  /// vigente EN EL MOMENTO del movimiento, copiado acá a propósito: si más
  /// adelante se corrige la equivalencia del producto en el catálogo, los
  /// movimientos históricos no deben cambiar de cantidad canónica (sección 6
  /// del prompt de Etapa 3: "las equivalencias históricas no deben provocar
  /// que un movimiento viejo cambie de cantidad"). `quantity = enteredQuantity
  /// * conversionFactor` se calcula una sola vez, al crear el movimiento.
  conversionFactor Int @map("conversion_factor")

  /// Obligatorio quedar registrado por aplicación para ADJUSTMENT (y
  /// COUNT_CORRECTION cuando exista) -- ver el CHECK agregado a mano en la
  /// migración (Prisma no expresa un NOT NULL condicional declarativamente),
  /// mismo patrón que el CHECK de `units_per_handling_unit` de Etapa 2.
  reason String?

  /// Referencia al documento que originó el movimiento cuando corresponde
  /// (venta, remito, merma, conteo, etc.) -- RESERVADO: ningún documento de
  /// ese tipo existe todavía en Etapa 3, pero el campo ya está preparado
  /// para que las etapas futuras no necesiten otra migración del ledger.
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId   String? @map("source_document_id") @db.Uuid

  /// Clave de idempotencia opcional para futuros orígenes externos
  /// (importaciones, ventas, cierres -- sección 14 del prompt de Etapa 3:
  /// "el motor debe quedar preparado para recibir movimientos... de
  /// procesos automáticos"). Ninguna operación de Etapa 3 la exige todavía
  /// (son altas manuales de Admin, no eventos externos repetibles), pero el
  /// mecanismo -- único por organización cuando está presente -- ya existe.
  idempotencyKey String? @map("idempotency_key")

  /// Movimiento original que este movimiento revierte (sección 13 del
  /// prompt: "una reversión debe preservar movimiento original, crear
  /// movimiento compensatorio, vincular ambos"). FK compuesta
  /// multi-organización auto-referencial -- una reversión sólo puede
  /// apuntar a un movimiento de la misma organización.
  reversesMovementId String? @map("reverses_movement_id") @db.Uuid

  status MovementStatus @default(ACTIVE)

  /// Fecha efectiva del movimiento (puede ser anterior al registro -- p. ej.
  /// un stock inicial cargado hoy pero efectivo desde el conteo físico de
  /// ayer). Distinta de `createdAt` (fecha de registro en el sistema),
  /// sección 4 del prompt de Etapa 3.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Usuario individual responsable (nunca una cuenta compartida de rol --
  /// sección 19 del prompt, P-001 ya resuelto). FK compuesta multi-organización.
  createdById String @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FKs compuestas (organizationId, x) -> Master(organizationId, id):
  /// aplica a este ledger lo aprendido en Etapa 2.1 -- ningún movimiento
  /// puede referenciar una ubicación, producto, unidad, usuario u otro
  /// movimiento de una organización distinta. Ver "Multi-organización" en
  /// docs/ETAPA-3-MOTOR-INVENTARIO.md.
  location            Location           @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  product              Product            @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  entryUnitOfMeasure   UnitOfMeasure      @relation(fields: [organizationId, entryUnitOfMeasureId], references: [organizationId, id], onDelete: Restrict)
  createdBy            AppUser            @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  reversesMovement     InventoryMovement? @relation("MovementReversal", fields: [organizationId, reversesMovementId], references: [organizationId, id], onDelete: Restrict)
  reversedByMovements  InventoryMovement[] @relation("MovementReversal")

  @@unique([organizationId, id])
  /// Idempotencia (sección 14 del prompt): un mismo evento externo (mismo
  /// idempotencyKey) no puede generar dos movimientos en la misma
  /// organización. NULL no colisiona con NULL (semántica estándar de
  /// PostgreSQL en UNIQUE), así que las altas manuales sin clave conviven
  /// sin problema.
  @@unique([organizationId, idempotencyKey])
  /// Consulta principal de stock teórico y de historial (sección 9/22 del
  /// prompt): agregación/filtro por ubicación+producto, ordenado por fecha.
  @@index([organizationId, locationId, productId, occurredAt])
  /// Trazabilidad por documento de origen (sección 29 del prompt).
  @@index([organizationId, sourceDocumentType, sourceDocumentId])
  @@index([organizationId, movementType])
  @@map("inventory_movement")
}
