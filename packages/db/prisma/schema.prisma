// Schema Prisma — Núcleo (Etapa 1 / Base-Core)
//
// Implementa únicamente las entidades estructurales definidas en
// docs/ETAPA-0-ANALISIS-ARQUITECTURA.md (sección 10.1, "Núcleo organizacional") y
// sección 10.9 ("Auditoría"). NO incluye ninguna tabla funcional de etapas
// posteriores (stock, ventas, mermas, BOM, cierres, caja, etc.) — ver
// docs/ETAPA-1-BASE-CORE.md, sección "Qué NO se implementó (a propósito)".
//
// Convenciones (idénticas a las de Etapa 0, sección 10):
//   - PK uuid con default aleatorio.
//   - organization_id NOT NULL en toda entidad operativa (RNF-011).
//   - created_at en toda tabla; updated_at sólo en catálogos editables in-place.
//   - Nunca DELETE físico de historial: audit_log es append-only (sin updated_at).
//   - Nombres de tabla/columna en snake_case en Postgres (vía @map/@@map);
//     camelCase del lado de Prisma/TypeScript, que es la convención idiomática
//     del ecosistema y no cambia el DDL real que Etapa 0 especificó.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Roles operativos confirmados por el relevamiento (Etapa 0, sección 7).
/// SUPER_ADMIN (Hito 2, multi-organización) no se agrega todavía: no está
/// respaldado como necesidad de Hito 1 y este informe no adelanta etapas futuras.
enum RoleCode {
  ADMIN
  DEPOSIT_MANAGER
  SHOP_EMPLOYEE

  @@map("role_code")
}

/// Tipos de ubicación (Etapa 0, sección 5): entidad genérica, no hardcodeada
/// como "depósito"/"heladería", tal como exige el documento de requisitos del cliente.
enum LocationType {
  DEPOT
  ICE_CREAM_SHOP
  STORE
  OTHER

  @@map("location_type")
}

enum AuditResult {
  OK
  ERROR
  REJECTED

  @@map("audit_result")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  timezone  String   @default("America/Argentina/Cordoba")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  locations              Location[]
  users                  AppUser[]
  auditLogs              AuditLog[]
  categories             Category[]
  productTypes           ProductType[]
  unitsOfMeasure         UnitOfMeasure[]
  flavors                Flavor[]
  products               Product[]
  inventoryMovements     InventoryMovement[]
  inventoryCounts        InventoryCount[]
  inventoryCountItems    InventoryCountItem[]
  wastes                 Waste[]
  variableExpenses       VariableExpense[]
  stockoutEvents         StockoutEvent[]
  salesImports           SalesImport[]
  salesImportRows        SalesImportRow[]
  sales                  Sale[]
  productAliases         ProductAlias[]
  billOfMaterialItems    BillOfMaterialItem[]
  weeklyClosings         WeeklyClosing[]
  inventorySnapshotItems InventorySnapshotItem[]

  @@map("organization")
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  type           LocationType
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users                  AppUser[]
  auditLogs              AuditLog[]
  inventoryMovements     InventoryMovement[]
  inventoryCounts        InventoryCount[]
  variableExpenses       VariableExpense[]
  stockoutEvents         StockoutEvent[]
  salesImports           SalesImport[]
  sales                  Sale[]
  weeklyClosings         WeeklyClosing[]
  inventorySnapshotItems InventorySnapshotItem[]

  @@unique([organizationId, name])
  /// Habilita FKs compuestas (organizationId, locationId) desde AppUser,
  /// AuditLog e InventoryMovement — Etapa 3 (ver
  /// docs/ETAPA-3-MOTOR-INVENTARIO.md, sección "Multi-organización").
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("location")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  code RoleCode @unique
  name String

  users AppUser[]

  @@map("role")
}

/// Identidad individual (P-001 RESUELTA — ver docs/ETAPA-0-ANALISIS-ARQUITECTURA.md v1.2,
/// sección 18.2, Opción A). Una fila = una persona física con cuenta propia en
/// Supabase Auth. Nunca una cuenta compartida por rol/ubicación como identidad principal.
model AppUser {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  roleId            String   @map("role_id") @db.Uuid
  /// Ubicación asignada. NULL para ADMIN (acceso a toda la organización) — ver
  /// docs/ETAPA-0-ANALISIS-ARQUITECTURA.md sección 7 (actores y permisos).
  defaultLocationId String?  @map("default_location_id") @db.Uuid
  displayName       String   @map("display_name")
  /// Email de contacto/invitación. Campo agregado en Etapa 1 (no estaba en el
  /// sketch de Etapa 0): es una necesidad técnica del flujo de alta de usuarios
  /// vía Supabase Auth (invitación por email), no un requisito de negocio nuevo.
  /// Ver docs/ETAPA-1-BASE-CORE.md, sección "Desviaciones respecto de Etapa 0".
  email             String   @unique
  /// id del usuario en Supabase Auth (auth.users.id). Es lo que llega en el JWT
  /// verificado por el backend en cada request.
  authSubject       String   @unique @map("auth_subject")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization                  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                          Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// FK compuesta (organizationId, defaultLocationId) -> Location(organizationId, id):
  /// pendiente detectado en Etapa 2.1 (docs/ETAPA-2.1-INTEGRIDAD-MULTIORGANIZACION.md,
  /// sección 14), corregido acá porque Etapa 3 ya necesita tocar AppUser/Location
  /// para el ledger y es seguro hacerlo sin ampliar alcance funcional. Nullable
  /// (NULL para ADMIN): Postgres no exige la FK cuando lo es. `onDelete: Restrict`
  /// (antes `SetNull` en la FK simple de Etapa 1): con FK compuesta, `SetNull`
  /// intentaría poner en NULL también `organizationId`, que es NOT NULL --
  /// Prisma lo señala como advertencia de esquema inválido. `Restrict` es
  /// coherente con el resto del esquema y con que `Location` nunca se borra
  /// físicamente (baja lógica vía `active`, Etapa 2).
  defaultLocation               Location?           @relation(fields: [organizationId, defaultLocationId], references: [organizationId, id], onDelete: Restrict)
  auditLogs                     AuditLog[]
  inventoryMovements            InventoryMovement[]
  inventoryCounts               InventoryCount[]
  variableExpenses              VariableExpense[]
  stockoutEvents                StockoutEvent[]
  /// Etapa 5 -- dos relaciones nombradas hacia AppUser porque un import
  /// distingue quién lo subió de quién lo confirmó (pueden ser personas
  /// distintas).
  salesImportsCreated           SalesImport[]       @relation("SalesImportCreatedBy")
  salesImportsConfirmed         SalesImport[]       @relation("SalesImportConfirmedBy")
  sales                         Sale[]
  productAliasesConfirmed       ProductAlias[]
  /// Etapa 6 -- cuatro relaciones nombradas: quien preparó/creó el cierre,
  /// quien confirmó haber revisado el checklist, quien lo cerró
  /// definitivamente y quien lo reabrió pueden ser personas distintas
  /// (igual criterio que SalesImportCreatedBy/ConfirmedBy).
  weeklyClosingsCreated         WeeklyClosing[]     @relation("WeeklyClosingCreatedBy")
  weeklyClosingsReviewConfirmed WeeklyClosing[]     @relation("WeeklyClosingReviewConfirmedBy")
  weeklyClosingsClosed          WeeklyClosing[]     @relation("WeeklyClosingClosedBy")
  weeklyClosingsReopened        WeeklyClosing[]     @relation("WeeklyClosingReopenedBy")

  /// Habilita FKs compuestas (organizationId, userId) desde AuditLog e
  /// InventoryMovement (createdBy) — Etapa 3.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([roleId])
  @@map("app_user")
}

/// Infraestructura de auditoría base (Etapa 1). `action`, `module`, `entityType` son
/// texto libre a propósito: los módulos funcionales futuros (stock, ventas, mermas,
/// caja, cierres) agregarán sus propias acciones sin requerir una migración de esquema
/// ni tocar esta tabla — ver docs/ETAPA-0-ANALISIS-ARQUITECTURA.md, sección 10.9 y 15.
/// Append-only: nunca se actualiza ni se borra un registro ya escrito (RN-009/RN-061).
model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  correlationId  String?     @map("correlation_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  roleCode       RoleCode?   @map("role_code")
  locationId     String?     @map("location_id") @db.Uuid
  action         String
  module         String
  entityType     String?     @map("entity_type")
  entityId       String?     @map("entity_id") @db.Uuid
  beforeValue    Json?       @map("before_value")
  afterValue     Json?       @map("after_value")
  reason         String?
  result         AuditResult @default(OK)
  errorDetail    String?     @map("error_detail")
  ipAddress      String?     @map("ip_address")
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FKs compuestas (organizationId, userId) y (organizationId, locationId):
  /// mismo pendiente de Etapa 2.1, corregido junto con AppUser.defaultLocationId
  /// en Etapa 3 (ver docs/ETAPA-3-MOTOR-INVENTARIO.md). Ambas nullable: Postgres
  /// no exige la FK cuando lo son (evento de sistema sin actor/ubicación).
  /// `onDelete: Restrict` por el mismo motivo que en AppUser.defaultLocation
  /// (SetNull es inválido en una FK compuesta con organizationId NOT NULL).
  user         AppUser?     @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  location     Location?    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, occurredAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Catálogo y maestros (Etapa 2) — ver docs/ETAPA-2-CATALOGO-MAESTROS.md.
//
// Sólo estructura de datos maestros (RF-001 a RF-007 de Etapa 0, CONFIRMADOS).
// Ninguna tabla de esta sección es un movimiento ni afecta stock: eso es el
// motor de inventario de una etapa posterior (ledger, conteos, BOM funcional,
// mermas, etc. — explícitamente fuera de Etapa 2).
//
// Baja lógica en las 5 entidades (nunca DELETE físico vía API): un maestro
// puede estar referenciado por historial futuro (productos, movimientos), así
// que todas usan `active`, igual que Location/AppUser en Etapa 1.

/// Categoría/grupo de producto (RF-002/RN-002, CONFIRMADO). Auto-referencial
/// para representar el "grupo" (parentCategoryId = null) y el "subgrupo"
/// opcional (RN-002: "un producto pertenece a un grupo y opcionalmente a un
/// subgrupo") con una única tabla, en vez de dos tablas separadas: ambos
/// niveles comparten exactamente los mismos atributos (nombre, organización,
/// estado), y el material real (hoja PRODUCTOS de Habash) sólo usa un nivel
/// plano de 35 categorías variables — no hay evidencia de una tabla de
/// subgrupos distinta, así que se prepara el nivel opcional sin inventar una
/// segunda entidad. Datos persistidos, nunca hardcodeados en frontend (Etapa 2 §5).
model Category {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  name             String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FK compuesta (organizationId, parentCategoryId) -> Category(organizationId, id):
  /// garantiza en PostgreSQL que una subcategoría no pueda apuntar a un grupo
  /// padre de otra organización (Etapa 2.1 — ver
  /// docs/ETAPA-2.1-INTEGRIDAD-MULTIORGANIZACION.md). Al ser parentCategoryId
  /// nullable, Postgres no exige la FK cuando es NULL (categoría raíz), que es
  /// el comportamiento deseado.
  parentCategory Category?    @relation("CategoryToSubcategory", fields: [organizationId, parentCategoryId], references: [organizationId, id], onDelete: Restrict)
  subcategories  Category[]   @relation("CategoryToSubcategory")
  products       Product[]

  @@unique([organizationId, parentCategoryId, name])
  /// Habilita que otras tablas (Product, la propia Category) referencien esta
  /// fila con una FK compuesta (organizationId, id) — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([parentCategoryId])
  @@map("category")
}

/// Tipo/línea de producto (RF-002, CONFIRMADO como campo; valores RESPALDADOS
/// por evidencia real: columna "PALLET" de la hoja PRODUCTOS de Habash sólo
/// contiene HELADO/INSUMO en las 214 filas reales -- ver
/// docs/ETAPA-2-CATALOGO-MAESTROS.md, matriz de decisiones). Tabla persistida
/// en vez de enum Prisma, igual criterio que Category (Etapa 2 §5: evitar
/// rigidez si no hay confirmación textual del cliente de que sea una lista
/// cerrada para siempre). Sin API de alta en esta etapa -- ver sección
/// "Permisos" del documento de Etapa 2: catálogo técnico sembrado, sólo lectura.
model ProductType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, code])
  /// Habilita la FK compuesta (organizationId, productTypeId) en Product — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("product_type")
}

/// Unidad de manejo (Etapa 2 §7: "unidad; lata; caja"). Tabla persistida, no
/// hardcodeada en frontend. Igual que ProductType: catálogo técnico sembrado
/// (evidencia real: columna UNIDAD de la hoja PRODUCTOS sólo usa
/// CAJA/LATA/UNIDAD), sin API de alta en esta etapa.
model UnitOfMeasure {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products           Product[]
  inventoryMovements InventoryMovement[]

  @@unique([organizationId, code])
  /// Habilita la FK compuesta (organizationId, unitOfMeasureId) en Product — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("unit_of_measure")
}

/// Sabor de helado (RF-003/RN-003, CONFIRMADO: "los sabores de helado a granel
/// siempre se registran, cuentan y analizan individualmente"). Entidad propia,
/// separada de Product, para que el análisis/consumo futuro por sabor no
/// dependa de una presentación/envase puntual -- aunque hoy, en el material
/// real, cada sabor corresponde 1:1 a un producto (lata), la relación
/// Product.flavorId permite que eso deje de ser así sin migrar el esquema.
model Flavor {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, name])
  /// Habilita la FK compuesta (organizationId, flavorId) en Product — Etapa 2.1.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("flavor")
}

/// Catálogo único de productos (RF-001, CONFIRMADO: "UUID propio, nunca el
/// nombre como clave"). Entidad central de Etapa 2 -- ver
/// docs/ETAPA-2-CATALOGO-MAESTROS.md, sección "Modelo implementado", para la
/// justificación completa de cada campo contra el material real y contra
/// RF-001..RF-007 de Etapa 0.
///
/// NO incluye: costo (RN-002/RN-003 lo ubican a nivel de Category, pero su
/// implementación real -- costo vigente, historial -- es RF-039, P3, fuera del
/// Hito 1; no se adelanta), código externo/SAP ni alias (RF-004 es CONFIRMADO
/// pero su único consumo es matching de importación de ventas/facturas,
/// explícitamente fuera de Etapa 2), BOM (RF-007, fuera de Etapa 2), stock
/// mínimo/ideal (pertenece al motor de inventario, fuera de Etapa 2).
model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  /// Código de negocio legible, opcional (RF-001: la clave real es el `id`
  /// UUID; este campo es sólo una referencia humana, como la que ya usa el
  /// sistema actual -- p. ej. "P001"). Único por organización cuando se define;
  /// Postgres permite múltiples NULL en una constraint UNIQUE, así que un
  /// producto sin código no colisiona con otro.
  code                 String?
  name                 String
  categoryId           String   @map("category_id") @db.Uuid
  productTypeId        String   @map("product_type_id") @db.Uuid
  unitOfMeasureId      String   @map("unit_of_measure_id") @db.Uuid
  /// Equivalencia/factor de conversión del producto (RF-002 "unidades por
  /// presentación"; RN-006 "factor de conversión del producto", singular):
  /// cuántas unidades sueltas contiene la unidad de manejo de este producto.
  /// 1 cuando la unidad de manejo ya es la unidad mínima (ej. LATA, UNIDAD).
  unitsPerHandlingUnit Int      @default(1) @map("units_per_handling_unit")
  /// Sabor asociado, sólo para productos que lo tienen (RF-003). NULL para
  /// insumos, packaging, etc.
  flavorId             String?  @map("flavor_id") @db.Uuid
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FKs compuestas (organizationId, xId) -> Master(organizationId, id) en las
  /// cuatro relaciones de abajo: garantizan en PostgreSQL que un producto no
  /// pueda referenciar una categoría/tipo/unidad/sabor de otra organización,
  /// además de la validación ya existente en el backend (Etapa 2.1 — ver
  /// docs/ETAPA-2.1-INTEGRIDAD-MULTIORGANIZACION.md). flavorId es nullable:
  /// Postgres no exige la FK cuando es NULL (producto sin sabor).
  category               Category                @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  productType            ProductType             @relation(fields: [organizationId, productTypeId], references: [organizationId, id], onDelete: Restrict)
  unitOfMeasure          UnitOfMeasure           @relation(fields: [organizationId, unitOfMeasureId], references: [organizationId, id], onDelete: Restrict)
  flavor                 Flavor?                 @relation(fields: [organizationId, flavorId], references: [organizationId, id], onDelete: Restrict)
  inventoryMovements     InventoryMovement[]
  inventoryCountItems    InventoryCountItem[]
  stockoutEvents         StockoutEvent[]
  sales                  Sale[]
  productAliases         ProductAlias[]
  inventorySnapshotItems InventorySnapshotItem[]
  /// Etapa 5 -- dos relaciones nombradas: un producto puede aparecer tanto
  /// como el producto VENDIDO de una receta (BomProduct) como el INSUMO
  /// consumido por la receta de otro producto (BomComponent).
  bomItemsAsProduct      BillOfMaterialItem[]    @relation("BomProduct")
  bomItemsAsComponent    BillOfMaterialItem[]    @relation("BomComponent")

  @@unique([organizationId, code])
  /// Habilita la FK compuesta (organizationId, productId) desde InventoryMovement — Etapa 3.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([categoryId])
  @@index([flavorId])
  @@map("product")
}

// ---------------------------------------------------------------------------
// Motor de inventario / ledger (Etapa 3) — ver docs/ETAPA-3-MOTOR-INVENTARIO.md
// y docs/INVARIANTES-INVENTARIO.md.
//
// Principio (CONFIRMADO, Doc §3.2/§10, RN-007): el stock es siempre una
// CONSECUENCIA de los movimientos del ledger, nunca un número editable. No
// existe ninguna columna "stock_actual": todo cálculo de stock teórico se
// hace agregando InventoryMovement en el momento de la consulta (sección
// "Cálculo de stock teórico" del documento de Etapa 3).
//
// Append-only (RN-008/RN-009): un InventoryMovement nunca se edita ni se
// borra una vez creado. Una corrección genera un movimiento de reversión
// nuevo (`reversesMovementId`) que referencia al original, que a su vez pasa
// a `status = REVERSED` — nunca se muta `quantity` de un movimiento existente.

/// Tipos de movimiento (RF-010, CONFIRMADO — lista textual del cliente, Doc
/// §10). El enum completo se declara ahora porque forma parte del dominio ya
/// confirmado y así ninguna etapa futura necesita una migración sólo para
/// agregar un valor a este enum (evitando un ALTER TYPE sobre una tabla que
/// crecerá continuamente) — pero sólo un subconjunto tiene, en esta etapa,
/// un servicio/endpoint que efectivamente lo genere (ver docs/ETAPA-3-MOTOR-INVENTARIO.md,
/// sección "Tipos de movimiento", que distingue IMPLEMENTADO de RESERVADO).
///
/// IMPLEMENTADO en Etapa 3: INITIAL_STOCK, ADJUSTMENT (y la reversión
/// genérica, que reutiliza el tipo del movimiento original).
/// RESERVADO/PREPARADO (el valor existe para integridad referencial futura,
/// ningún endpoint de Etapa 3 lo genera todavía): PURCHASE_RECEIPT,
/// TRANSFER_OUT, TRANSFER_IN, SALE, BOM_CONSUMPTION, WASTE,
/// ICE_CREAM_CONTAINER_CLOSE, EXTERNAL_OUT, COUNT_CORRECTION.
enum MovementType {
  INITIAL_STOCK
  PURCHASE_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  BOM_CONSUMPTION
  WASTE
  ICE_CREAM_CONTAINER_CLOSE
  ADJUSTMENT
  EXTERNAL_OUT
  COUNT_CORRECTION

  @@map("movement_type")
}

/// Estado del movimiento (arquitectura Etapa 0, sección 10.3/11.4). NO es un
/// filtro del cálculo de stock teórico -- el saldo siempre suma TODOS los
/// movimientos (activos y revertidos), porque la reversión ya aporta su
/// propia cantidad de signo opuesto (ver apps/api/src/services/inventory-ledger.ts,
/// `getStockBalances`); excluir los REVERSED del SUM restaría el original
/// sin sumar de vuelta su efecto y dejaría el saldo mal calculado. `status`
/// sirve sólo para trazabilidad (marcar qué movimiento fue corregido) y como
/// guarda contra una doble reversión del mismo movimiento (sólo se puede
/// revertir un movimiento con status = ACTIVE).
enum MovementStatus {
  ACTIVE
  REVERSED

  @@map("movement_status")
}

/// Ledger central de movimientos de inventario (RF-009, RN-007..RN-010,
/// CONFIRMADO). Única puerta de escritura de stock del sistema — ver
/// apps/api/src/services/inventory-ledger.ts.
model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  locationId     String       @map("location_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  movementType   MovementType @map("movement_type")

  /// Cantidad normalizada a la unidad canónica del producto ("unidades
  /// sueltas", el mismo concepto que `Product.unitsPerHandlingUnit` ya usa
  /// desde Etapa 2 — RESPALDADO, no una entidad nueva). Con signo: entradas
  /// positivas, salidas negativas (RN-010, arquitectura Etapa 0 §10.3). Es
  /// la que se usa para calcular el stock teórico (SUM). NUMERIC en vez de
  /// float de JS/Postgres double precision, para no perder precisión al
  /// sumar miles de movimientos -- ver docs/ETAPA-3-MOTOR-INVENTARIO.md,
  /// sección "Cantidades y precisión", sobre la escala elegida.
  quantity Decimal @db.Decimal(14, 3)

  /// Cantidad tal como la tipeó el usuario, en `entryUnitOfMeasureId` (RN-006:
  /// "el usuario nunca calcula la conversión a mano"). Mismo signo que
  /// `quantity`. Se conserva junto al factor usado para que la pantalla
  /// pueda mostrar "2 cajas" además del canónico, sin recalcular.
  enteredQuantity Decimal @map("entered_quantity") @db.Decimal(14, 3)

  /// Unidad en la que se cargó el movimiento (p. ej. la unidad de manejo del
  /// producto). FK compuesta multi-organización -- sección "Multi-organización".
  entryUnitOfMeasureId String @map("entry_unit_of_measure_id") @db.Uuid

  /// Factor de conversión (equivalente a `Product.unitsPerHandlingUnit`)
  /// vigente EN EL MOMENTO del movimiento, copiado acá a propósito: si más
  /// adelante se corrige la equivalencia del producto en el catálogo, los
  /// movimientos históricos no deben cambiar de cantidad canónica (sección 6
  /// del prompt de Etapa 3: "las equivalencias históricas no deben provocar
  /// que un movimiento viejo cambie de cantidad"). `quantity = enteredQuantity
  /// * conversionFactor` se calcula una sola vez, al crear el movimiento.
  conversionFactor Int @map("conversion_factor")

  /// Obligatorio quedar registrado por aplicación para ADJUSTMENT (y
  /// COUNT_CORRECTION cuando exista) -- ver el CHECK agregado a mano en la
  /// migración (Prisma no expresa un NOT NULL condicional declarativamente),
  /// mismo patrón que el CHECK de `units_per_handling_unit` de Etapa 2.
  reason String?

  /// Referencia al documento que originó el movimiento cuando corresponde
  /// (venta, remito, merma, conteo, etc.) -- RESERVADO: ningún documento de
  /// ese tipo existe todavía en Etapa 3, pero el campo ya está preparado
  /// para que las etapas futuras no necesiten otra migración del ledger.
  sourceDocumentType String? @map("source_document_type")
  sourceDocumentId   String? @map("source_document_id") @db.Uuid

  /// Clave de idempotencia opcional para futuros orígenes externos
  /// (importaciones, ventas, cierres -- sección 14 del prompt de Etapa 3:
  /// "el motor debe quedar preparado para recibir movimientos... de
  /// procesos automáticos"). Ninguna operación de Etapa 3 la exige todavía
  /// (son altas manuales de Admin, no eventos externos repetibles), pero el
  /// mecanismo -- único por organización cuando está presente -- ya existe.
  idempotencyKey String? @map("idempotency_key")

  /// Huella de la identidad semántica del payload que generó este movimiento
  /// (Etapa 3.1, corrección del Problema 3: "la idempotencia debe distinguir
  /// un retry legítimo de una reutilización con contenido incompatible").
  /// Sólo tiene sentido junto a `idempotencyKey` -- se guarda un string JSON
  /// canónico de los campos que definen la operación (tipo, ubicación,
  /// producto, cantidad ingresada, motivo, fecha efectiva EXPLÍCITA si se
  /// mandó una -- nunca el timestamp interno generado por el servidor). Ver
  /// `apps/api/src/services/inventory-ledger.ts`,
  /// `computeIdempotencyFingerprint`.
  idempotencyFingerprint String? @map("idempotency_fingerprint")

  /// Movimiento original que este movimiento revierte (sección 13 del
  /// prompt: "una reversión debe preservar movimiento original, crear
  /// movimiento compensatorio, vincular ambos"). FK compuesta
  /// multi-organización auto-referencial -- una reversión sólo puede
  /// apuntar a un movimiento de la misma organización.
  reversesMovementId String? @map("reverses_movement_id") @db.Uuid

  status MovementStatus @default(ACTIVE)

  /// Fecha efectiva del movimiento (puede ser anterior al registro -- p. ej.
  /// un stock inicial cargado hoy pero efectivo desde el conteo físico de
  /// ayer). Distinta de `createdAt` (fecha de registro en el sistema),
  /// sección 4 del prompt de Etapa 3.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Usuario individual responsable (nunca una cuenta compartida de rol --
  /// sección 19 del prompt, P-001 ya resuelto). FK compuesta multi-organización.
  createdById String @map("created_by") @db.Uuid

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// FKs compuestas (organizationId, x) -> Master(organizationId, id):
  /// aplica a este ledger lo aprendido en Etapa 2.1 -- ningún movimiento
  /// puede referenciar una ubicación, producto, unidad, usuario u otro
  /// movimiento de una organización distinta. Ver "Multi-organización" en
  /// docs/ETAPA-3-MOTOR-INVENTARIO.md.
  location              Location               @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  product               Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  entryUnitOfMeasure    UnitOfMeasure          @relation(fields: [organizationId, entryUnitOfMeasureId], references: [organizationId, id], onDelete: Restrict)
  createdBy             AppUser                @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  reversesMovement      InventoryMovement?     @relation("MovementReversal", fields: [organizationId, reversesMovementId], references: [organizationId, id], onDelete: Restrict)
  reversedByMovements   InventoryMovement[]    @relation("MovementReversal")
  /// Presente sólo cuando `movementType = WASTE` y se originó desde la
  /// pantalla de mermas de Etapa 4 (ver modelo `Waste` más abajo).
  waste                 Waste?
  /// Presente sólo cuando `movementType = COUNT_CORRECTION` y se originó
  /// desde un cierre semanal de Etapa 6 (ver `InventorySnapshotItem` más
  /// abajo) -- mismo patrón 1:1 opcional que `waste` de Etapa 4.
  inventorySnapshotItem InventorySnapshotItem?

  @@unique([organizationId, id])
  /// Idempotencia (sección 14 del prompt): un mismo evento externo (mismo
  /// idempotencyKey) no puede generar dos movimientos en la misma
  /// organización. NULL no colisiona con NULL (semántica estándar de
  /// PostgreSQL en UNIQUE), así que las altas manuales sin clave conviven
  /// sin problema.
  @@unique([organizationId, idempotencyKey])
  // Etapa 3.1, corrección del Problema 1 (reversión concurrente): a lo sumo
  // una fila puede tener un `reversesMovementId` dado, por organización --
  // garantiza a nivel de PostgreSQL que un movimiento nunca tenga más de una
  // reversión, incluso si dos requests concurrentes lograran pasar la
  // verificación de la capa de aplicación. Índice único PARCIAL (no
  // expresable declarativamente en schema.prisma -- agregado a mano en la
  // migración, mismo patrón que el índice de INITIAL_STOCK de Etapa 3):
  //   CREATE UNIQUE INDEX ... ON inventory_movement(organization_id,
  //   reverses_movement_id) WHERE reverses_movement_id IS NOT NULL;
  // Es la segunda capa de la corrección -- la primera es el
  // `UPDATE ... WHERE status = 'ACTIVE'` atómico de `reverseMovement` (ver
  // apps/api/src/services/inventory-ledger.ts). No se representa acá como
  // @@unique porque Prisma no soporta índices parciales declarativos.
  /// Consulta principal de stock teórico y de historial (sección 9/22 del
  /// prompt): agregación/filtro por ubicación+producto, ordenado por fecha.
  @@index([organizationId, locationId, productId, occurredAt])
  /// Trazabilidad por documento de origen (sección 29 del prompt).
  @@index([organizationId, sourceDocumentType, sourceDocumentId])
  @@index([organizationId, movementType])
  @@map("inventory_movement")
}

// ---------------------------------------------------------------------------
// App Heladería Operativa (Etapa 4) — ver docs/ETAPA-4-APP-HELADERIA.md.
//
// Consume el ledger de Etapa 3 sin reabrirlo: el conteo, la baja de lata, la
// merma y el evento de sin-stock generan (o comparan contra) InventoryMovement
// existentes -- ninguno de los modelos de acá abajo duplica lo que el ledger
// ya resuelve (RF-009..RF-026, RN-007..RN-033, Doc §15-§20). "Dar de baja
// lata" en particular NO tiene tabla propia: es un InventoryMovement
// ICE_CREAM_CONTAINER_CLOSE más (ver `closeIceCreamContainer` en
// apps/api/src/services/inventory-ledger.ts) -- sección 7 del prompt de
// Etapa 4 sólo pide los mismos campos que ya tiene cualquier movimiento.
//
// Gasto variable NO es parte del ledger de inventario (sección 9 del prompt:
// "este módulo NO forma parte del ledger de inventario") -- tiene su propia
// entidad/transacción, sin relación con InventoryMovement.

/// Estado del conteo físico semanal (RF-012/RN-012..018, sección 1 del prompt
/// de Etapa 4). Nombres tomados literalmente del prompt vigente de Etapa 4 en
/// vez de los sugeridos en la propuesta conceptual original de Etapa 0
/// (`RECOUNT_REQUESTED`/`CLOSED`) -- documentado como decisión explícita en
/// docs/ETAPA-4-APP-HELADERIA.md: `COMPLETED` evita confundirse con el futuro
/// `weekly_closing.status = CLOSED` (Etapa 6), que es un concepto distinto
/// (cierre semanal administrativo, fuera de alcance acá).
///
/// `DRAFT` se declara por completitud del dominio pero, en esta etapa, NUNCA
/// se persiste una fila en ese estado: el conteo se arma enteramente en el
/// dispositivo (IndexedDB, RF-013) y sólo llega al backend ya armado, vía
/// `POST /api/shop/counts`, que lo crea directamente en `SUBMITTED` y lo hace
/// avanzar en la misma transacción a `RECOUNT_REQUIRED` o `COMPLETED` según
/// corresponda -- ver la sección "Autoguardado" de
/// docs/ETAPA-4-APP-HELADERIA.md sobre por qué no existe un endpoint de
/// "guardar borrador en el servidor".
enum InventoryCountStatus {
  DRAFT
  SUBMITTED
  RECOUNT_REQUIRED
  COMPLETED

  @@map("inventory_count_status")
}

/// Fracción estimada del contenido de una lata abierta (RF-020/RN-025,
/// CONFIRMADO textualmente por el cliente: "llena, 3/4, 1/2, 1/4, casi
/// vacía"). Reemplaza el pesaje real con balanza del sistema anterior
/// (`Pesajes.gs`) -- explícitamente NO requerido por el documento del
/// cliente (ver docs/ETAPA-0-ANALISIS-ARQUITECTURA.md, nota sobre pesajes
/// bajo RF-023). Se reutiliza también en `Waste` cuando una merma se
/// registra como fracción de una lata en vez de cantidad exacta (sección 8
/// del prompt: "cantidad O FRACCIÓN").
enum OpenContainerFraction {
  FULL
  THREE_QUARTERS
  HALF
  QUARTER
  NEARLY_EMPTY

  @@map("open_container_fraction")
}

/// Conteo físico semanal, ciego, por ubicación (RF-012, Doc §15). Un conteo
/// por (ubicación, semana) -- `weekStart` lo calcula el frontend (el lunes
/// de la semana en curso, hora local del dispositivo) y se manda explícito,
/// mismo patrón que `occurredAt` ya usa el ledger desde Etapa 3: no se le
/// exige al servidor adivinar en qué huso horario "hoy es lunes".
model InventoryCount {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  locationId     String               @map("location_id") @db.Uuid
  weekStart      DateTime             @map("week_start") @db.Date
  status         InventoryCountStatus @default(SUBMITTED)

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  /// Cuándo el reconteo (si hizo falta) quedó confirmado -- distinto de
  /// `submittedAt`, que es el envío ORIGINAL (sección 5/6 del prompt:
  /// conservar la diferencia original, no sólo la final).
  recountedAt DateTime? @map("recounted_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  createdById String @map("created_by") @db.Uuid

  /// Idempotencia del envío original (sección 12 del prompt: "conteos...
  /// pueden reenviarse después de cortes de conexión"). Obligatoria acá (a
  /// diferencia de `InventoryMovement.idempotencyKey`, opcional): el origen
  /// es siempre una PWA con conectividad intermitente, nunca una carga
  /// manual de escritorio.
  idempotencyKey         String @map("idempotency_key")
  idempotencyFingerprint String @map("idempotency_fingerprint")

  /// Idempotencia del RECONTEO (Etapa 4.1, sección 2/3 -- corrige que dos
  /// requests concurrentes representando el mismo reconteo pudieran
  /// resolver en 2xx/409 en vez de 2xx/2xx). Columnas separadas de
  /// `idempotencyKey`/`idempotencyFingerprint` de arriba (esas son del
  /// envío ORIGINAL del conteo, una operación distinta) -- nunca se
  /// reutiliza ambiguamente una clave para dos operaciones diferentes.
  /// NULL hasta que este conteo efectivamente pase por un reconteo (a lo
  /// sumo una ronda adicional, sección 5 del prompt original).
  recountIdempotencyKey         String? @map("recount_idempotency_key")
  recountIdempotencyFingerprint String? @map("recount_idempotency_fingerprint")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location             @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  createdBy    AppUser              @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  items        InventoryCountItem[]

  /// Habilita la FK compuesta (organizationId, countId) desde
  /// InventoryCountItem.
  @@unique([organizationId, id])
  /// A lo sumo un conteo por ubicación y semana (mismo criterio que la
  /// propuesta conceptual de Etapa 0, sección 10.4, sin el discriminador
  /// `kind` -- INITIAL_STOCK ya tiene su propio mecanismo en Etapa 3 y no se
  /// duplica acá).
  @@unique([organizationId, locationId, weekStart])
  @@unique([organizationId, idempotencyKey])
  /// NULLs no colisionan entre sí en un índice único de Postgres, así que
  /// esto sólo restringe reutilizar la misma clave de RECONTEO en dos
  /// conteos distintos -- no afecta a los conteos que todavía no tuvieron
  /// ningún reconteo.
  @@unique([organizationId, recountIdempotencyKey])
  @@index([organizationId, locationId, weekStart])
  @@map("inventory_count")
}

/// Línea de conteo por producto (RF-020, Doc §10.4 `stock_count_line`).
/// `closedUnits`/`openUnits`/`openFraction` sirven a los DOS modos de
/// captura de la sección 3/4 del prompt con los mismos tres campos, sin
/// discriminador de tipo explícito -- exactamente el diseño conceptual ya
/// confirmado por el cliente en Etapa 0:
///  - producto cerrado ("2 cajas + 5 unidades"): `closedUnits` = cajas
///    cerradas, `openUnits` = unidades sueltas (conteo EXACTO), `openFraction`
///    siempre NULL (no se estima a ojo un conteo cerrado).
///  - sabor a granel: `closedUnits` = latas cerradas, `openUnits` = latas
///    ABIERTAS, `openFraction` = fracción estimada del contenido de esas
///    latas abiertas (obligatoria cuando `openUnits > 0`).
model InventoryCountItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  countId        String @map("count_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  /// CHECK >= 0 y CHECK (openFraction IS NULL OR openUnits > 0) agregados a
  /// mano en la migración (Prisma no expresa CHECK declarativamente) --
  /// mismo patrón que los CHECK de `InventoryMovement`.
  closedUnits  Int?                   @map("closed_units")
  openUnits    Int?                   @map("open_units")
  openFraction OpenContainerFraction? @map("open_fraction")

  /// Cantidad física, normalizada a la unidad canónica del producto (mismo
  /// concepto que `InventoryMovement.quantity`) -- calculada UNA VEZ por el
  /// backend a partir de `closedUnits`/`openUnits`/`openFraction` y
  /// `Product.unitsPerHandlingUnit`, nunca por el frontend (sección 3 del
  /// prompt: "la empleada no debe hacer multiplicaciones").
  physicalQuantity Decimal @map("physical_quantity") @db.Decimal(14, 3)

  /// Completado por el backend DESPUÉS de guardar el conteo (conteo ciego,
  /// RN-012) -- nunca antes. NULL hasta ese momento, nunca expuesto al
  /// empleado mientras cuenta (sección 1 del prompt).
  theoreticalQuantity Decimal? @map("theoretical_quantity") @db.Decimal(14, 3)
  /// = physicalQuantity - theoreticalQuantity (sección 6 del prompt, RN-016).
  /// Se conserva para siempre, incluso si en una etapa futura un ADMIN la
  /// justifica y corrige el ledger -- nunca se sobrescribe.
  difference          Decimal? @db.Decimal(14, 3)

  /// true si `|difference|` superó el umbral configurado para la categoría
  /// de este producto (sección 5 del prompt) -- ver
  /// docs/ETAPA-4-APP-HELADERIA.md, "Reconteo inteligente", sobre los
  /// umbrales (NINGÚN valor está inventado; sin configurar, nunca se marca).
  needsRecount Boolean @default(false) @map("needs_recount")
  /// true una vez que este ítem específico ya pasó por su segundo conteo
  /// (sección 5: "solicitar SEGUNDO conteo" -- una sola ronda adicional, no
  /// un loop; ver decisión documentada en docs/ETAPA-4-APP-HELADERIA.md).
  recounted    Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  count        InventoryCount @relation(fields: [organizationId, countId], references: [organizationId, id], onDelete: Restrict)
  product      Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  /// Un producto aparece una única vez por conteo.
  @@unique([countId, productId])
  @@index([organizationId, countId])
  @@map("inventory_count_item")
}

/// Merma con foto (RF-024/025, RN-029..032). Deliberadamente NO duplica
/// `quantity`/`reason`/`locationId`/`productId`/`occurredAt`/`createdById`:
/// esos ya están en el `InventoryMovement` WASTE que la merma genera --
/// `movementId` los referencia. Sólo agrega lo que el ledger no tiene: la
/// foto (RN-029: obligatoria) y la idempotencia propia del alta desde la PWA.
///
/// "Costo perdido" / "valor de venta perdido" por separado (RN-032) queda
/// PENDIENTE: depende de costo/precio vigente por producto, que el catálogo
/// de Etapa 2 explícitamente no modela todavía (RF-039, P3, fuera del Hito
/// 1) -- ver docs/ETAPA-4-APP-HELADERIA.md, "Pendientes".
model Waste {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Movimiento WASTE generado en la misma transacción -- ver
  /// `createWaste` en apps/api/src/services/inventory-ledger.ts. La
  /// idempotencia de la merma NO se duplica acá: es la del propio
  /// `InventoryMovement` (`idempotencyKey`/`idempotencyFingerprint`, ya
  /// existentes desde Etapa 3) la que decide si el alta es un retry
  /// legítimo o un conflicto -- exactamente el mismo mecanismo que
  /// INITIAL_STOCK/ADJUSTMENT, sin inventar uno paralelo.
  movementId     String   @map("movement_id") @db.Uuid
  /// Ruta dentro de Supabase Storage (bucket privado), NUNCA una URL pública
  /// ni base64 en la base de datos (sección 8 del prompt) -- ver
  /// docs/ETAPA-4-APP-HELADERIA.md, "Storage".
  photoPath      String   @map("photo_path")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  movement     InventoryMovement @relation(fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, movementId])
  @@map("waste")
}

/// Gasto variable de una heladería (RF-026/RN-033). Entidad propia, sin
/// relación con el ledger de inventario (sección 9 del prompt) ni con caja
/// (Etapa 7, fuera de alcance). `category` es texto libre configurable, no
/// un catálogo cerrado -- ningún catálogo de categorías está CONFIRMADO
/// todavía (sección 9 del prompt: "no inventar categorías obligatorias").
/// `receiptPath` es nullable a propósito: RN-033 dice literalmente
/// "comprobante (si existe)", no obligatorio.
model VariableExpense {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  category       String
  description    String
  /// Ruta en Supabase Storage (bucket privado) -- ver `Waste.photoPath`.
  receiptPath    String?  @map("receipt_path")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String   @map("created_by") @db.Uuid

  idempotencyKey         String @map("idempotency_key")
  idempotencyFingerprint String @map("idempotency_fingerprint")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  createdBy    AppUser      @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, locationId, occurredAt])
  @@map("variable_expense")
}

/// Clasificación de un evento "sin stock" (RF-019/RN-019, CONFIRMADO
/// textualmente: "reposición urgente posible" / "faltante de
/// abastecimiento"). Nombres tomados de la propuesta conceptual de Etapa 0
/// (`URGENT_RESTOCK`/`SUPPLY_SHORTAGE`), sección 10.5.
enum StockoutClassification {
  URGENT_RESTOCK
  SUPPLY_SHORTAGE

  @@map("stockout_classification")
}

/// Evento "sin stock" (RF-019/RN-019). NO es un movimiento de inventario --
/// no modifica stock, no crea stock artificial, no bloquea nada por saldo
/// negativo (sección 10 del prompt). `classification` se calcula, cuando es
/// posible, leyendo el stock YA EXISTENTE de las ubicaciones tipo DEPOT de
/// la organización (mismo cálculo de `getStockBalances`, sin ninguna
/// funcionalidad de depósito nueva) -- NULL si no hay ninguna ubicación
/// DEPOT configurada, en vez de inventar una clasificación por defecto.
model StockoutEvent {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  locationId     String                  @map("location_id") @db.Uuid
  productId      String                  @map("product_id") @db.Uuid
  classification StockoutClassification?
  occurredAt     DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdById    String                  @map("created_by") @db.Uuid

  idempotencyKey         String @map("idempotency_key")
  idempotencyFingerprint String @map("idempotency_fingerprint")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  createdBy    AppUser      @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, locationId, occurredAt])
  @@map("stockout_event")
}

// ---------------------------------------------------------------------------
// Importador de ventas (Etapa 5) — ver docs/ETAPA-5-IMPORTADOR-VENTAS.md.
//
// Fuente real inspeccionada: reporte "Mix de Ventas" del POS (archivo real
// del cliente, exportado con el filtro "Precios: Desagrupados" para no
// perder la identificación de Canje/promoción por línea -- la variante
// "Agrupados" fusiona esas líneas y pierde esa distinción). Un producto se
// identifica por el código numérico `articulo` del POS (estable entre
// filas), nunca por su descripción de texto (que cambia según el precio o
// la promoción aplicada). Ni el conteo ni la baja de lata ni la merma se
// tocan -- este importador sólo agrega SALE y BOM_CONSUMPTION al ledger ya
// existente de Etapa 3, reutilizando `sourceDocumentType`/`sourceDocumentId`
// (ya RESERVADOS desde Etapa 3 para esto) en vez de una tabla de
// trazabilidad nueva.

/// Origen técnico de un import (identifica qué parser/columnas usar). Sólo
/// `MIX_VENTAS` tiene evidencia real hoy -- agregar un origen nuevo (ej. un
/// futuro importador de cierres de Mercado Pago, mencionado por el cliente
/// pero fuera de alcance de esta etapa) es una migración simple que agrega
/// un valor al enum, no un rediseño.
enum SalesImportSource {
  MIX_VENTAS
}

/// Estados del import (sección 15 del prompt de Etapa 5). Una vez
/// CONFIRMED, sus efectos (Sale, movimientos SALE/BOM_CONSUMPTION,
/// auditoría) son inmutables -- una corrección futura es una reversa
/// trazable, nunca una edición silenciosa.
enum SalesImportStatus {
  /// Archivo recibido, todavía sin parsear (estado transitorio dentro de la
  /// misma request de subida).
  UPLOADED
  /// Parseado con éxito; puede confirmarse (puede tener filas UNMAPPED --
  /// eso nunca bloquea, sección 7).
  PREVIEW_READY
  /// Parseado, pero el total de las filas válidas no reconcilia contra el
  /// "Total General" que el propio archivo declara -- condición crítica sin
  /// resolver (sección 13): no se puede confirmar hasta subir un archivo
  /// corregido.
  BLOCKED
  /// Confirmado: ventas, movimientos SALE/BOM_CONSUMPTION y auditoría ya
  /// generados, de forma inmutable.
  CONFIRMED
  /// El archivo no pudo interpretarse en absoluto (formato no soportado,
  /// hoja/encabezados distintos a los esperados) -- no llega a generar
  /// ningún preview.
  FAILED
}

/// Validez de una fila parseada (no confunde "sin mapear" -- que es un
/// estado normal y esperado, sección 7 -- con "dato corrupto"). El mapeo a
/// Product se resuelve en vivo contra ProductAlias en cada consulta de
/// preview/confirmación, nunca se cachea acá -- así un alias creado después
/// de la subida se toma en cuenta sin tener que resubir el archivo.
enum SalesImportRowStatus {
  VALID
  ERROR
}

/// Una subida de archivo (RF de Etapa 5, sección 6 del prompt: "Admin
/// selecciona ubicación... Admin sube archivo"). `fileHash` es un SHA-256
/// del contenido exacto del archivo -- la idempotencia de subida (sección
/// 8) se apoya en el índice único de abajo, nunca en el nombre del archivo.
model SalesImport {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  locationId     String            @map("location_id") @db.Uuid
  source         SalesImportSource

  originalFilename String  @map("original_filename")
  fileHash         String  @map("file_hash")
  /// Path en Supabase Storage del archivo original conservado (sección 19
  /// del prompt) -- nunca el contenido en base64 en esta tabla.
  storagePath      String? @map("storage_path")

  /// Rango de fechas que el propio reporte declara (columnas `desde`/`hasta`
  /// del archivo) -- el archivo no trae fecha por línea (limitación real del
  /// export, documentada como supuesto en vez de inventar una fecha por
  /// venta).
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  status SalesImportStatus @default(UPLOADED)

  totalRows       Int      @default(0) @map("total_rows")
  validRows       Int      @default(0) @map("valid_rows")
  errorRows       Int      @default(0) @map("error_rows")
  totalQuantity   Decimal  @default(0) @map("total_quantity") @db.Decimal(14, 3)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// Total que el propio archivo declara en su fila "Total General" --
  /// usado para la reconciliación de la sección 13, conservado para
  /// auditoría/depuración.
  fileStatedTotal Decimal? @map("file_stated_total") @db.Decimal(14, 2)

  blockedReason String? @map("blocked_reason")
  failedReason  String? @map("failed_reason")

  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  confirmedById String?   @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)

  /// Idempotencia de la CONFIRMACIÓN (sección 9 del prompt, mismo patrón
  /// endurecido en Etapa 3.2/4.1: clave + fingerprint + UNIQUE + resolución
  /// explícita de carrera) -- deliberadamente separada de `fileHash` (esa es
  /// la idempotencia de SUBIDA, una operación distinta).
  confirmIdempotencyKey         String? @map("confirm_idempotency_key")
  confirmIdempotencyFingerprint String? @map("confirm_idempotency_fingerprint")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     Location         @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  createdBy    AppUser          @relation("SalesImportCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  confirmedBy  AppUser?         @relation("SalesImportConfirmedBy", fields: [organizationId, confirmedById], references: [organizationId, id], onDelete: Restrict)
  rows         SalesImportRow[]
  sales        Sale[]

  /// Habilita la FK compuesta (organizationId, salesImportId) desde
  /// SalesImportRow/Sale.
  @@unique([organizationId, id])
  /// Idempotencia de SUBIDA (sección 8): subir el mismo archivo exacto dos
  /// veces para la misma ubicación no genera un segundo import. NULL no
  /// colisiona con NULL (no aplica acá, fileHash siempre se completa al
  /// crear la fila).
  @@unique([organizationId, locationId, fileHash])
  @@unique([organizationId, confirmIdempotencyKey])
  @@index([organizationId, locationId, createdAt])
  @@map("sales_import")
}

/// Una fila del archivo ya parseada y validada (RF sección 5: "filas
/// originales relevantes"). Guarda sólo las columnas REALMENTE presentes en
/// el archivo real inspeccionado -- ver docs/ETAPA-5-IMPORTADOR-VENTAS.md,
/// "Columnas utilizadas/ignoradas" -- nunca el Excel entero como blob.
model SalesImportRow {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  salesImportId  String @map("sales_import_id") @db.Uuid

  /// Número de fila en el archivo original (base 0, incluye el encabezado)
  /// -- para que un error se pueda señalar exactamente como en el Excel.
  rowNumber Int @map("row_number")

  /// Código numérico de artículo del POS (columna `articulo`) -- identidad
  /// ESTABLE del producto entre filas, nunca la descripción de texto
  /// (sección 7 del prompt: "no usar nombre como FK").
  rawArticleCode String @map("raw_article_code")
  /// Descripción completa tal cual viene en el archivo (columna
  /// `artdescrip`), incluyendo el sufijo de promoción/Canje entre
  /// paréntesis cuando corresponde -- nunca editada.
  rawDescription String @map("raw_description")
  /// Grupo/rubro del artículo (columna `grudescrip`) -- sólo informativo.
  rawGroup       String @map("raw_group")

  /// Cantidad vendida (columna `cantidad`), en la unidad de manejo PROPIA
  /// del artículo tal como lo carga el POS -- la conversión a cantidad
  /// canónica la hace el backend con `Product.unitsPerHandlingUnit` al
  /// confirmar, igual criterio que el resto del ledger (nunca en el
  /// cliente).
  quantity Decimal @db.Decimal(14, 3)
  /// Importe REAL de la línea (columna `total`) -- la facturación se toma
  /// de acá, nunca de un precio de lista teórico (sección 3 del prompt).
  amount   Decimal @db.Decimal(14, 2)

  /// true si la columna `promocion` viene con un código distinto de cero --
  /// el POS aplicó algún precio promocional a esta línea (Canje u otro tipo
  /// de promoción, p. ej. descuentos de apps de delivery).
  isPromotion   Boolean @default(false) @map("is_promotion")
  /// true si, además, la descripción incluye la palabra "Canje" (evidencia
  /// real: es el único indicador textual que el propio archivo usa para un
  /// canje puntual -- nunca se asume un % fijo de descuento, sección 4 del
  /// prompt).
  isCanje       Boolean @default(false) @map("is_canje")
  promotionCode String? @map("promotion_code")

  /// Columnas presentes en el archivo real pero sólo informativas (sección
  /// 3 del prompt: "se pueden almacenar cuando sean útiles, sólo si están
  /// efectivamente presentes") -- ninguna participa del cálculo de
  /// facturación ni de stock.
  unitPriceAvg Decimal? @map("unit_price_avg") @db.Decimal(14, 4)
  bultos       String?
  kilos        Decimal? @db.Decimal(14, 3)
  pctOfTotal   Decimal? @map("pct_of_total") @db.Decimal(9, 4)

  status       SalesImportRowStatus
  errorMessage String?              @map("error_message")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesImport  SalesImport  @relation(fields: [organizationId, salesImportId], references: [organizationId, id], onDelete: Restrict)
  sale         Sale?

  @@unique([organizationId, salesImportId, rowNumber])
  /// Habilita la FK compuesta (organizationId, salesImportRowId) desde Sale.
  @@unique([organizationId, id])
  @@index([organizationId, salesImportId, status])
  @@map("sales_import_row")
}

/// Mapeo ADMIN-confirmado entre un código externo (`articulo` del POS) y un
/// Product del catálogo (sección 7 del prompt: "alias por fuente"). Nunca
/// se crea sola/automáticamente -- toda fila de acá la escribió
/// explícitamente un ADMIN (`confirmedById`), incluso si el valor sugerido
/// vino de una coincidencia textual.
model ProductAlias {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  source              SalesImportSource
  externalCode        String            @map("external_code")
  /// Última descripción externa vista para este código -- sólo para mostrar
  /// contexto en el admin-web, nunca se usa para resolver el mapeo.
  externalDescription String?           @map("external_description")
  productId           String            @map("product_id") @db.Uuid

  confirmedById String   @map("confirmed_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  confirmedBy  AppUser      @relation(fields: [organizationId, confirmedById], references: [organizationId, id], onDelete: Restrict)

  /// A lo sumo un mapeo por código externo, por fuente, por organización.
  @@unique([organizationId, source, externalCode])
  @@index([organizationId, productId])
  @@map("product_alias")
}

/// Receta/BOM (RF-007 e Insumos y BOM/recetas del documento del cliente,
/// sección 18: "las recetas se gestionan en base de datos, nunca
/// hardcodeadas"). `quantityPerUnit` está expresada en unidad CANÓNICA del
/// componente por cada unidad CANÓNICA del producto vendido -- mismo
/// criterio de "todo en unidad canónica" que ya usa `InventoryMovement`.
model BillOfMaterialItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Producto VENDIDO (el que dispara el consumo al confirmarse una venta).
  productId          String  @map("product_id") @db.Uuid
  /// Insumo/componente CONSUMIDO por cada unidad del producto vendido.
  componentProductId String  @map("component_product_id") @db.Uuid
  quantityPerUnit    Decimal @map("quantity_per_unit") @db.Decimal(14, 6)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product          Product      @relation("BomProduct", fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  componentProduct Product      @relation("BomComponent", fields: [organizationId, componentProductId], references: [organizationId, id], onDelete: Restrict)

  /// Una única línea de receta por par (producto vendido, componente) --
  /// para cambiar la cantidad se actualiza esta fila, no se duplica.
  @@unique([organizationId, productId, componentProductId])
  @@index([organizationId, productId])
  @@map("bill_of_material_item")
}

/// Venta CONFIRMADA (hecho inmutable, sección 5/15 del prompt) -- distinta
/// de `SalesImportRow` (el dato crudo parseado, que existe desde el
/// preview). Sólo se crea una fila acá para una `SalesImportRow` que, al
/// momento de la confirmación, resuelve a un Product vía ProductAlias
/// (sección 7: "si no está mapeado, no impactar stock" -- una fila sin
/// mapear nunca genera un Sale). `occurredAt` usa `periodEnd` del import:
/// el archivo no trae fecha por línea (ver comentario de SalesImport) --
/// supuesto documentado, reversible sin migrar.
model Sale {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId     String @map("location_id") @db.Uuid

  salesImportId    String @map("sales_import_id") @db.Uuid
  salesImportRowId String @map("sales_import_row_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid

  quantity   Decimal @db.Decimal(14, 3)
  amountReal Decimal @map("amount_real") @db.Decimal(14, 2)

  isPromotion Boolean @default(false) @map("is_promotion")
  isCanje     Boolean @default(false) @map("is_canje")

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  /// El movimiento SALE que esta venta generó en el ledger (1:1, mismo
  /// patrón que `Waste.movementId` de Etapa 4: reutiliza el ledger
  /// existente en vez de duplicar su idempotencia/transacción). Los
  /// eventuales movimientos BOM_CONSUMPTION de esta venta se referencian al
  /// revés, vía `InventoryMovement.sourceDocumentType = 'SALE'` +
  /// `sourceDocumentId = Sale.id` (mismo mecanismo RESERVADO desde Etapa 3,
  /// sin agregar una tabla de trazabilidad nueva).
  movementId String @map("movement_id") @db.Uuid

  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       Location       @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  salesImport    SalesImport    @relation(fields: [organizationId, salesImportId], references: [organizationId, id], onDelete: Restrict)
  salesImportRow SalesImportRow @relation(fields: [organizationId, salesImportRowId], references: [organizationId, id], onDelete: Restrict)
  product        Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  createdBy      AppUser        @relation(fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)

  /// A lo sumo una Sale por fila importada -- protege contra un retry de
  /// confirmación que intente crear la venta dos veces por fuera de la
  /// idempotencia de `SalesImport.confirmIdempotencyKey` (defensa en
  /// profundidad, mismo criterio que Waste.movementId).
  @@unique([organizationId, salesImportRowId])
  @@unique([organizationId, movementId])
  @@index([organizationId, locationId, occurredAt])
  @@map("sale")
}

/// Estado del cierre semanal (Etapa 6, sección 11 del prompt). Deliberadamente
/// sólo tres valores PERSISTIDOS -- "INCOMPLETE"/"READY_TO_CLOSE" sugeridos
/// por el documento del cliente (sección 24.1) son ESTADOS DERIVADOS, nunca
/// guardados: se calculan en el momento a partir del checklist (mismo
/// criterio que `SalesImportPreview.canConfirm` de Etapa 5.1 -- ver
/// `apps/api/src/services/weekly-closing.ts`, `computeChecklist`). Guardar un
/// booleano/enum aparte para eso arriesgaría desincronizarse del checklist
/// real; derivarlo siempre en el momento lo hace imposible.
enum WeeklyClosingStatus {
  /// Semana operativa en curso, todavía no cerrada. Único estado desde el
  /// que se puede cerrar (`close`).
  OPEN
  /// Cierre definitivo: inmutable (sección 16 del prompt) -- ninguna
  /// operación de Etapa 6 modifica un WeeklyClosing en este estado, salvo
  /// `reopen`, que lo mueve a REOPENED.
  CLOSED
  /// Reabierto por un ADMIN (sección 12): el `InventorySnapshotItem` de la
  /// revisión CLOSED anterior se preserva intacto (nunca se edita/borra) --
  /// un nuevo cierre desde acá genera una revisión nueva, no reescribe la
  /// vieja. Desde REOPENED se puede volver a cerrar (nueva revisión) igual
  /// que desde OPEN.
  REOPENED

  @@map("weekly_closing_status")
}

/// Cierre semanal del núcleo operativo (Etapa 6, RF conceptual del documento
/// del cliente sección 24, CONFIRMADO). Consolida el estado de una semana
/// [periodStart..periodEnd] para una ubicación después de que conteo físico,
/// mermas, retiros de latas, gastos variables y ventas importadas ya están
/// cargados -- nunca reemplaza al ledger (`InventoryMovement` sigue siendo
/// la única fuente de verdad de stock, sección 2 del prompt): esta tabla
/// sólo consulta/compara/consolida y genera un snapshot histórico.
///
/// Período semanal (sección 4 del prompt, documento del cliente sección 24,
/// cita textual): "Período: lunes a domingo. Cierre: lunes siguiente." ->
/// `periodStart` es SIEMPRE un lunes, `periodEnd = periodStart + 6` (el
/// domingo de esa misma semana) -- CHECK agregado a mano en la migración
/// (Prisma no expresa `periodEnd = periodStart + 6` declarativamente, mismo
/// patrón que otros CHECK del proyecto).
///
/// Qué conteo gobierna el cierre de un período [Lunes N .. Domingo N]: el
/// documento del cliente (sección 15) confirma que "el conteo semanal
/// principal se realiza los lunes por la mañana, antes de recibir o
/// despachar mercadería" -- es decir, el conteo tomado el lunes SIGUIENTE
/// (N+7) es el que valida lo ocurrido DURANTE el período N (el conteo del
/// propio lunes N valida en cambio el CIERRE del período anterior). Por
/// eso el backend busca el `InventoryCount` con
/// `weekStart = periodStart + 7 días` -- ver
/// `apps/api/src/services/weekly-closing.ts`, `getGoverningInventoryCount`,
/// y docs/ETAPA-6-CIERRE-SEMANAL.md, sección "Período semanal", para el
/// ejemplo concreto de fechas con el que se verificó este razonamiento.
model WeeklyClosing {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  locationId     String              @map("location_id") @db.Uuid
  periodStart    DateTime            @map("period_start") @db.Date
  periodEnd      DateTime            @map("period_end") @db.Date
  status         WeeklyClosingStatus @default(OPEN)

  /// Confirmación ÚNICA y consolidada de que un ADMIN revisó el checklist
  /// completo (mermas, gastos, ventas importadas, etc.) antes de cerrar --
  /// sección 5 del prompt: "si el modelo actual no tiene forma inequívoca de
  /// distinguir 'no hubo mermas' de 'nadie revisó las mermas', no inventar
  /// una regla oculta". En vez de un flag booleano por sub-ítem (mermas
  /// revisadas / gastos revisados / etc., que multiplicaría columnas sin
  /// necesidad real), se usa UN solo gesto explícito de revisión que cubre
  /// todo el checklist a la vez -- el ADMIN ve el resumen completo en la
  /// misma pantalla antes de confirmar (sección 19). `countSubmitted` (ver
  /// servicio) es la única sub-condición que SÍ se verifica de forma
  /// automática e inequívoca (existencia de un InventoryCount COMPLETED).
  reviewConfirmedById String?   @map("review_confirmed_by") @db.Uuid
  reviewConfirmedAt   DateTime? @map("review_confirmed_at") @db.Timestamptz(6)

  /// Incrementada en cada cierre exitoso (empieza en 0, pasa a 1 en el
  /// primer `close`, a 2 si se reabre y se vuelve a cerrar, etc.). Sección
  /// 12 del prompt: "preferir versionado... antes que mutar el snapshot
  /// anterior" -- cada `InventorySnapshotItem` generado por un `close` queda
  /// etiquetado con el valor de `currentRevision` vigente EN ESE MOMENTO,
  /// así que reabrir y volver a cerrar nunca sobrescribe ni borra filas de
  /// una revisión previa.
  currentRevision Int @default(0) @map("current_revision")

  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Reflejan el cierre MÁS RECIENTE (si se reabre y se vuelve a cerrar, se
  /// sobrescriben con los datos del nuevo cierre) -- el cierre anterior
  /// queda igual trazado a través de `reopenedAt`/`reopenedById` y de las
  /// filas de `InventorySnapshotItem` con `revision` menor.
  closedById String?   @map("closed_by") @db.Uuid
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  /// Reflejan la reapertura MÁS RECIENTE. `reopenReason` obligatorio a nivel
  /// de aplicación (operación sensible, sección 12 del prompt) -- CHECK a
  /// mano en la migración exige `reopen_reason IS NOT NULL` cuando
  /// `reopened_at IS NOT NULL`, mismo patrón que el CHECK de `reason` en
  /// `InventoryMovement`.
  reopenedById String?   @map("reopened_by") @db.Uuid
  reopenedAt   DateTime? @map("reopened_at") @db.Timestamptz(6)
  reopenReason String?   @map("reopen_reason")

  /// Idempotencia del cierre definitivo (sección 13 del prompt, mismo patrón
  /// que Etapa 3.1/4.1: UNIQUE + fingerprint + resolución explícita de
  /// carrera reconsultando Postgres). Se resetea a NULL en cada `reopen`
  /// para que el próximo `close` pueda usar una clave nueva -- un reintento
  /// de un `close` YA reabierto nunca debe confundirse con el cierre
  /// anterior (clave distinta = revisión distinta).
  closeIdempotencyKey         String? @map("close_idempotency_key")
  closeIdempotencyFingerprint String? @map("close_idempotency_fingerprint")

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location          Location                @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  createdBy         AppUser                 @relation("WeeklyClosingCreatedBy", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  reviewConfirmedBy AppUser?                @relation("WeeklyClosingReviewConfirmedBy", fields: [organizationId, reviewConfirmedById], references: [organizationId, id], onDelete: Restrict)
  closedBy          AppUser?                @relation("WeeklyClosingClosedBy", fields: [organizationId, closedById], references: [organizationId, id], onDelete: Restrict)
  reopenedBy        AppUser?                @relation("WeeklyClosingReopenedBy", fields: [organizationId, reopenedById], references: [organizationId, id], onDelete: Restrict)
  snapshotItems     InventorySnapshotItem[]

  /// Habilita la FK compuesta (organizationId, weeklyClosingId) desde
  /// InventorySnapshotItem.
  @@unique([organizationId, id])
  /// A lo sumo un WeeklyClosing por ubicación y período -- evita períodos
  /// superpuestos y dos cierres activos para la misma ubicación/período
  /// (sección 4 del prompt).
  @@unique([organizationId, locationId, periodStart])
  @@unique([organizationId, closeIdempotencyKey])
  @@index([organizationId, locationId, periodStart])
  @@map("weekly_closing")
}

/// Snapshot histórico e inmutable de un producto al momento de un cierre
/// semanal (sección 9 del prompt, CONFIRMADO). Nunca se recalcula
/// retroactivamente con valores actuales -- congela `quantityTheoretical`/
/// `quantityReal`/`difference` copiados directamente de la línea de
/// `InventoryCountItem` que gobierna el cierre (nunca recalculados de forma
/// independiente, para no arriesgar una discrepancia con el conteo real).
///
/// Valoración monetaria (sección 10 del prompt) DELIBERADAMENTE OMITIDA: hoy
/// `Product` no tiene ningún campo de costo/precio (el documento del cliente,
/// secciones 12/13/23/46, reserva la lista de costos/precios explícitamente
/// para "Hito 1b en adelante" -- `SalesImportRow.unitPriceAvg` de Etapa 5 es
/// un promedio informativo de precio de VENTA, no un costo, y no corresponde
/// como fuente de valoración de inventario). Inventar FIFO, costo promedio
/// ponderado, margen o cualquier criterio de valoración sin esa fuente
/// violaría la sección 10 del prompt ("no inventar") -- ver
/// docs/ETAPA-6-CIERRE-SEMANAL.md, sección "Valoración", para la limitación
/// documentada.
model InventorySnapshotItem {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  /// Denormalizado desde el WeeklyClosing para consultas directas por
  /// ubicación (misma convención que otras tablas del proyecto, p. ej.
  /// `Sale.locationId` ya denormalizado desde `SalesImport`).
  locationId      String @map("location_id") @db.Uuid
  weeklyClosingId String @map("weekly_closing_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid

  /// Coincide con `WeeklyClosing.currentRevision` en el momento en que esta
  /// fila se generó -- distingue las filas de cierres sucesivos del mismo
  /// WeeklyClosing (reabierto y vuelto a cerrar) sin mutar ni borrar las
  /// anteriores (sección 12 del prompt).
  revision Int

  /// Copiados directamente de `InventoryCountItem.theoreticalQuantity` /
  /// `.physicalQuantity` / `.difference` del conteo gobernante -- nunca
  /// recalculados acá (sección 7 del prompt).
  quantityTheoretical Decimal @map("quantity_theoretical") @db.Decimal(14, 3)
  quantityReal        Decimal @map("quantity_real") @db.Decimal(14, 3)
  difference          Decimal @db.Decimal(14, 3)

  /// Movimiento COUNT_CORRECTION generado por este cierre para reconciliar
  /// la diferencia (sección 8 del prompt, documento del cliente sección
  /// 16.1: "el real pasa a ser el nuevo punto de partida operativo... la
  /// diferencia histórica se conserva"). NULL cuando `difference = 0` --
  /// nunca se genera un ajuste sin diferencia real.
  countCorrectionMovementId String? @map("count_correction_movement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location                Location           @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  weeklyClosing           WeeklyClosing      @relation(fields: [organizationId, weeklyClosingId], references: [organizationId, id], onDelete: Restrict)
  product                 Product            @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  countCorrectionMovement InventoryMovement? @relation(fields: [organizationId, countCorrectionMovementId], references: [organizationId, id], onDelete: Restrict)

  /// Una fila por producto y revisión de un mismo cierre -- reabrir y volver
  /// a cerrar genera una revisión nueva (sección 12), nunca reescribe la
  /// anterior.
  @@unique([organizationId, weeklyClosingId, productId, revision])
  /// A lo sumo un InventorySnapshotItem por movimiento COUNT_CORRECTION
  /// (defensa en profundidad; NULLs no colisionan entre sí en Postgres, así
  /// que esto no afecta a las filas con `difference = 0`).
  @@unique([organizationId, countCorrectionMovementId])
  @@index([organizationId, locationId, productId])
  @@index([organizationId, weeklyClosingId])
  @@map("inventory_snapshot_item")
}
