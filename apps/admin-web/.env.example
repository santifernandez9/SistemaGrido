# =============================================================================
# apps/admin-web — frontend Admin (desktop)
# =============================================================================
# Vite sólo expone al cliente las variables que empiezan con VITE_ -- y sólo esas
# (nunca pongas acá una service role key ni nada secreto: esto termina en el
# bundle que corre en el navegador de cualquiera).

VITE_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key-de-supabase>"

# URL del backend (apps/api). En desarrollo, el puerto por defecto de Fastify.
VITE_API_URL="http://localhost:3000"
