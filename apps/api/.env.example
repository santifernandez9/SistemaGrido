# =============================================================================
# apps/api — backend (Fastify)
# =============================================================================

NODE_ENV=development
PORT=3000

# Ver packages/db/.env.example para el detalle de DATABASE_URL vs DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistemagrido_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sistemagrido_dev?schema=public"

# Supabase (Project Settings -> API). SUPABASE_URL y SUPABASE_ANON_KEY son públicos
# (el mismo valor que usan los frontends); SUPABASE_SERVICE_ROLE_KEY es SECRETO — nunca
# lo uses en el frontend ni lo commitees. El backend lo necesita sólo para el alta de
# usuarios (Supabase Auth Admin API: invitar/crear personas) y no para nada más.
SUPABASE_URL="https://<tu-proyecto>.supabase.co"
SUPABASE_ANON_KEY="<anon-key-de-supabase>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-de-supabase-NUNCA-en-frontend>"

# Orígenes permitidos por CORS, separados por coma. En desarrollo, los puertos de Vite
# de admin-web y shop-pwa. En producción: las URLs reales de Vercel.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Nivel de log de Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
