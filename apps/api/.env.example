# =============================================================================
# apps/api — backend (Fastify)
# =============================================================================

NODE_ENV=development
PORT=3000

# Ver packages/db/.env.example para el detalle de DATABASE_URL vs DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sistemagrido_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sistemagrido_dev?schema=public"

# Supabase (Project Settings -> API). SUPABASE_URL y SUPABASE_ANON_KEY son públicos
# (el mismo valor que usan los frontends); SUPABASE_SERVICE_ROLE_KEY es SECRETO — nunca
# lo uses en el frontend ni lo commitees. El backend lo necesita sólo para el alta de
# usuarios (Supabase Auth Admin API: invitar/crear personas) y no para nada más.
SUPABASE_URL="https://<tu-proyecto>.supabase.co"
SUPABASE_ANON_KEY="<anon-key-de-supabase>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-de-supabase-NUNCA-en-frontend>"

# Orígenes permitidos por CORS, separados por coma. En desarrollo, los puertos de Vite
# de admin-web y shop-pwa. En producción: las URLs reales de Vercel.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Nivel de log de Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Etapa 4 (App Heladería Operativa) — ver docs/ETAPA-4-APP-HELADERIA.md.
# Bucket PRIVADO de Supabase Storage para fotos de merma y comprobantes de
# gasto (creado a mano en el dashboard de Supabase, sin RLS pública -- el
# backend firma URLs de subida/lectura con la service role key).
SHOP_ATTACHMENTS_BUCKET=shop-attachments

# Umbrales de diferencia que disparan un reconteo (sección 5 del prompt de
# Etapa 4). SIN VALOR CONFIRMADO todavía por el cliente (P-002) -- dejar
# ambas sin definir mantiene el reconteo automático deshabilitado, en vez de
# inventar un número. No son porcentajes ni cantidades fijas per se: la
# unidad es la misma que `physical_quantity`/`difference` (unidad canónica
# del producto).
# RECOUNT_THRESHOLD_CLOSED_PRODUCTS=
# RECOUNT_THRESHOLD_BULK_FLAVOR=

# Fracción numérica de "casi vacía" (0 a 1) al estimar el contenido de una
# lata abierta. SIN VALOR CONFIRMADO por el cliente (Etapa 4.1, sección 1)
# -- dejarla sin definir es la opción correcta hasta confirmarlo: cualquier
# conteo o merma que necesite convertir NEARLY_EMPTY a cantidad canónica
# sin esta variable configurada se rechaza con un error explícito de
# configuración (503 CONFIGURATION_ERROR), nunca con un número inventado.
# Ver docs/ETAPA-4-APP-HELADERIA.md, "Supuestos".
# BULK_FLAVOR_NEARLY_EMPTY_FRACTION=
